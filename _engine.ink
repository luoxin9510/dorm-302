// Generated by Inkwright from the game's notes. Do not edit; regenerate.

LIST characters = xin, yanbo, zhiyong, yi
VAR character = xin

// Skills of the current character (loaded by pick_character)
VAR reason = 0
VAR stamina = 0
VAR charm = 0
VAR insight = 0
VAR strength = 0

// Resources
VAR fear = 0
VAR hp = 10
VAR battery = 80
VAR dawn = 8

// Items: what the character carries (`~ inv += phone`, `{inv ? phone: …}`)
LIST items = phone, pepper, band, bank, notebook, pole, key, lighter, card, ledger
VAR inv = ()

// Dice: the engine sets these; saved with the state, so back/load/replay roll the same
VAR dice_seed = 0
VAR dice_rolls = 0

// Text in the story's language: {t("zh…", "en…")}; the play panel switches lang.
VAR lang = "zh"

=== function t(zh, en) ===
{ lang == "en":
    ~ return en
}
~ return zh

// Companions
VAR fear_xin = 30
VAR trust_xin = 60
VAR fear_yanbo = 15
VAR trust_yanbo = 60
VAR fear_zhiyong = 35
VAR trust_zhiyong = 55
VAR fear_yi = 15
VAR trust_yi = 50

EXTERNAL check(skill, difficulty)

// Loads a character's preset by id: pick_character("xin")
=== function pick_character(who) ===
{ who == "xin":
    ~ character = xin
    ~ reason = 3
    ~ stamina = 3
    ~ charm = 5
    ~ insight = 4
    ~ strength = 2
    ~ inv = (phone)
}
{ who == "yanbo":
    ~ character = yanbo
    ~ reason = 5
    ~ stamina = 2
    ~ charm = 3
    ~ insight = 3
    ~ strength = 5
    ~ inv = ()
}
{ who == "zhiyong":
    ~ character = zhiyong
    ~ reason = 2
    ~ stamina = 5
    ~ charm = 2
    ~ insight = 2
    ~ strength = 6
    ~ inv = ()
}
{ who == "yi":
    ~ character = yi
    ~ reason = 4
    ~ stamina = 2
    ~ charm = 3
    ~ insight = 5
    ~ strength = 1
    ~ inv = ()
}

// A skill's current level, by name.
=== function skill_level(skill) ===
{ skill == "reason":
    ~ return reason
}
{ skill == "stamina":
    ~ return stamina
}
{ skill == "charm":
    ~ return charm
}
{ skill == "insight":
    ~ return insight
}
{ skill == "strength":
    ~ return strength
}
~ return 0

// Without the engine there are no dice or modifiers: the average roll (7) decides.
=== function check(skill, difficulty) ===
{ skill_level(skill) + 7 >= difficulty:
    ~ return 3
}
~ return 1

// Dice outside a check: {roll("2d6+3")} → the total.
EXTERNAL roll_dice(formula, label)

=== function roll(formula) ===
~ return roll_dice(formula, "")

// Without the engine the dice are flat: each table's average, 1 for anything else.
=== function roll_dice(formula, label) ===
~ return 1
